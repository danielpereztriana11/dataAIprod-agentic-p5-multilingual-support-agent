# Proposed configuration for future integrations; not loaded by the scaffold.
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=en
# Set the credentials for your chosen provider locally when integrating it.
# MODEL_API_KEY=
# MODEL_NAME=
# Prototype model configuration (set these in the shell; this project does not load .env automatically).
# Choose ONE provider; never commit the actual key.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MODEL=  # optional: overrides the provider-specific default in prototype/draft.py
# Set to use a locally running Ollama model without an API key.
# OLLAMA_MODEL=qwen2.5:1.5b
# Optional local semantic retrieval (requires ollama pull paraphrase-multilingual).
# RETRIEVAL_MODE=semantic
